#!/bin/sh
# Regenerate SEO files (pre-rendered HTML, JSON-LD, sitemap) from data/*.json
# and include them in the commit. Enable once per clone with:
#   git config core.hooksPath .githooks
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping tools/seo.mjs" >&2
  exit 0
fi
node tools/seo.mjs >/dev/null || { echo "pre-commit: tools/seo.mjs failed" >&2; exit 1; }
git add index.html projects.html sitemap.xml
